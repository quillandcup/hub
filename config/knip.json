{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/app/**/{page,layout,route,loading,error,global-error,not-found,default,template}.{ts,tsx}",
    "src/app/{manifest,sitemap,robots,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
    "src/proxy.ts",
    "instrumentation*.ts",
    "next.config.ts",
    "config/app.ts",
    "config/env-vars.ts",
    "config/checkly/checkly.config.ts",
    "config/eslint-quality.mjs",
    "config/checkly/__checks__/**/*.{check,setup}.ts",
    "scripts/*.ts",
    "tests/demo/*.ts",
    "tests/demo/scenes/**/*.ts",
    "tests/demo/video/*.ts",
    "src/emails/**/*.tsx",
    "tests/**/*.{ts,tsx}"
  ],
  "project": [
    "src/app/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "src/lib/**/*.{ts,tsx}",
    "src/content/**/*.{ts,tsx}",
    "src/emails/**/*.{ts,tsx}",
    "scripts/**/*.ts",
    "tests/**/*.{ts,tsx}",
    "*.{ts,mts,mjs}"
  ],
  "ignore": ["src/lib/data/database.types.ts", "supabase/**", ".next/**", ".next-demo/**", "tests/demo/.stack/**"],
  "ignoreBinaries": ["supabase", "ffmpeg", "ffprobe", "say", "xattr"],
  "ignoreExportsUsedInFile": true
}
