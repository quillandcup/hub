{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint -c config/eslint.mjs .",
    "typecheck": "next typegen && tsc --noEmit",
    "knip:report": "mkdir -p reports && (knip --config config/knip.json --reporter json > reports/knip.json || true)",
    "dup:report": "jscpd . --config config/jscpd.json || true",
    "lint:quality": "mkdir -p reports && (eslint -c config/eslint-quality.mjs --no-warn-ignored -f json -o reports/eslint-quality.json . || true)",
    "quality:report": "tsx scripts/quality-report.ts",
    "quality:gate": "tsx scripts/quality-gate.ts",
    "types:gen": "npx --yes supabase@2.117.0 gen types typescript --local --schema public --schema bronze > lib/data/database.types.ts.tmp && mv lib/data/database.types.ts.tmp lib/data/database.types.ts",
    "types:check": "pnpm types:gen && git diff --exit-code -- lib/data/database.types.ts",
    "prospects:assess": "tsx scripts/assess-prospects.ts",
    "tunnel": "tsx --env-file-if-exists=.env.local scripts/tunnel.ts",
    "test": "vitest --config config/vitest.mts",
    "test:ui": "vitest --config config/vitest.mts --ui",
    "test:unit": "vitest --config config/vitest.mts run --project unit",
    "test:db": "vitest --config config/vitest.mts run --project db",
    "test:smoke": "vitest --config config/vitest.mts run --project smoke",
    "test:unit:coverage": "vitest --config config/vitest.mts run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "test:db:coverage": "vitest --config config/vitest.mts run --project db --coverage --coverage.reportsDirectory=coverage/db",
    "test:pgtap": "scripts/test-pgtap.sh",
    "demo:stack": "tsx tests/demo/stack.ts",
    "demo:app": "dotenv run -f tests/demo/.env.demo -- next dev -p 3100",
    "demo:build": "NEXT_DIST_DIR=.next-demo dotenv run -f tests/demo/.env.demo -- next build",
    "demo:serve": "NEXT_DIST_DIR=.next-demo dotenv run -f tests/demo/.env.demo -- next start -p 3100",
    "demo:seed": "tsx tests/demo/seed.ts",
    "seed:local": "tsx scripts/seed-local.ts",
    "demo:baseline": "tsx tests/demo/baseline.ts",
    "demo:publish": "tsx tests/demo/publish.ts",
    "demo:video": "playwright test --config tests/demo/video/playwright.config.ts",
    "demo:reading:sheet": "tsx tests/demo/video/reading-sheet.ts",
    "demo:reading:split": "tsx tests/demo/video/split-reading.ts",
    "demo:phone-overflow": "playwright test --config tests/demo/playwright.config.ts phone-overflow --project=phone-light",
    "demo:capture": "playwright test --config tests/demo/playwright.config.ts",
    "changelog:capture": "tsx scripts/changelog-capture.ts",
    "changelog:draft": "tsx scripts/changelog-draft.ts",
    "check:migrations": "tsx scripts/check-migration-order.ts",
    "disposable-domains:update": "tsx scripts/update-disposable-email-domains.ts",
    "branches:prune": "tsx scripts/prune-branches.ts",
    "test:run": "vitest --config config/vitest.mts run",
    "export:slack": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx scripts/export-slack-data.ts",
    "supabase:start": "supabase start &",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:push": "dotenv run -f .env.prod -- supabase db push",
    "db:up": "supabase migration up",
    "env:sync": "tsx scripts/sync-to-vercel.ts",
    "env:sync:github": "tsx scripts/sync-to-github.ts",
    "env:sync:vault": "tsx scripts/sync-vault-secrets.ts",
    "templates:render": "tsx scripts/render-email-templates.ts",
    "courses:content": "tsx scripts/kajabi-course-content.ts",
    "covers:adopt": "tsx scripts/adopt-book-covers.ts",
    "photos:adopt": "tsx scripts/adopt-member-photos.ts",
    "books:import": "tsx scripts/import-storefront-books.ts",
    "config:diff": "dotenv run -f .env.prod -- supabase config diff",
    "config:push": "dotenv run -f .env.prod -- supabase config push",
    "slack:manifest:diff": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/slack-manifest.ts diff",
    "slack:manifest:push": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/slack-manifest.ts push",
    "auth:precreate": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/precreate-auth-users.ts",
    "checkin-dms:close": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/close-checkin-dms.ts",
    "launch:email": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/send-launch-emails.ts",
    "slack:bot-token": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/slack-bot-token.ts",
    "sentry:config:diff": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/sentry-config.ts diff",
    "sentry:config:push": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/sentry-config.ts push",
    "github:config:diff": "tsx scripts/github-config.ts diff",
    "github:config:push": "tsx scripts/github-config.ts push",
    "mux:config:diff": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/mux-config.ts diff",
    "mux:config:push": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/mux-config.ts push",
    "mux:config:diff:dev": "dotenv run -f .env.local -- tsx scripts/mux-config.ts diff --dev",
    "mux:config:push:dev": "dotenv run -f .env.local -- tsx scripts/mux-config.ts push --dev",
    "page-speed": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/page-speed.ts",
    "vercel:config:diff": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/vercel-config.ts diff",
    "vercel:config:push": "dotenv run -f .env.prod -f .env.shared -- tsx scripts/vercel-config.ts push",
    "quarantine:remove": "xattr -r -d com.apple.quarantine node_modules",
    "docs:toc": "doctoc --update-only --notitle --minlevel 2 --maxlevel 3",
    "prepare": "husky"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@googleapis/calendar": "^20.2.0",
    "@mux/ts": "^16.2.0",
    "@mux/upchunk": "^3.5.0",
    "@next/third-parties": "16.4.6",
    "@puckeditor/core": "^0.24.0",
    "@sentry/nextjs": "^11.12.0",
    "@slack/web-api": "^8.4.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tiptap/extension-image": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.1.0",
    "@videojs/mux-data": "10.4.0",
    "@videojs/mux-video": "^10.4.0",
    "@videojs/react": "^10.4.0",
    "bowser": "^2.15.0",
    "dotenv": "^18.0.10",
    "emojibase-data": "^18.0.0",
    "fflate": "^0.8.3",
    "heic-convert": "^2.1.0",
    "html-to-image": "^1.11.13",
    "image-size": "^2.1.0",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^1.73.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "parse5": "8.1.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.13",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.2",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "turndown": "^7.2.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@slack/types": "^3.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/turndown": "^5.0.6",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "@vitest/ui": "^4.1.12",
    "autoprefixer": "^10.6.2",
    "checkly": "latest",
    "doctoc": "^2.5.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-sonarjs": "^4.2.2",
    "husky": "^9.1.7",
    "jscpd": "^5.4.3",
    "jsdom": "^30.1.3",
    "knip": "^6.46.1",
    "msw": "^2.15.0",
    "playwright": "^1.65.1",
    "postcss": "^8.5.33",
    "slack-blocks-to-jsx": "^1.5.1",
    "squawk-cli": "^2.73.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^60.1.3",
    "vite": "8.3.8",
    "vitest": "^4.1.12",
    "yaml": "^2.9.1"
  }
}
