{
  "name": "hub",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.6.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "types:gen": "supabase gen types typescript --local --schema public --schema bronze > lib/data/database.types.ts",
    "types:check": "pnpm types:gen && git diff --exit-code -- lib/data/database.types.ts",
    "tunnel": "tsx --env-file-if-exists=.env.local scripts/tunnel.ts",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:unit": "vitest run --project unit",
    "test:db": "vitest run --project db",
    "test:unit:coverage": "vitest run --project unit --coverage --coverage.reportsDirectory=coverage/unit",
    "test:db:coverage": "vitest run --project db --coverage --coverage.reportsDirectory=coverage/db",
    "test:pgtap": "scripts/test-pgtap.sh",
    "demo:stack": "tsx demo/stack.ts",
    "demo:app": "dotenv -e demo/.env.demo -- next dev -p 3100",
    "demo:serve": "dotenv -e demo/.env.demo -- next start -p 3100",
    "demo:seed": "tsx demo/seed.ts",
    "demo:publish": "tsx demo/publish.ts",
    "demo:capture": "playwright test --config demo/playwright.config.ts",
    "check:migrations": "tsx scripts/check-migration-order.ts",
    "branches:prune": "tsx scripts/prune-branches.ts",
    "test:run": "vitest run",
    "export:slack": "NODE_OPTIONS='--dns-result-order=ipv4first' tsx scripts/export-slack-data.ts",
    "supabase:start": "supabase start &",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:push": "dotenv -e .env.prod -- supabase db push",
    "db:up": "supabase migration up",
    "env:sync": "tsx scripts/sync-to-vercel.ts",
    "env:sync:github": "tsx scripts/sync-to-github.ts",
    "env:sync:vault": "tsx scripts/sync-vault-secrets.ts",
    "templates:render": "tsx scripts/render-email-templates.ts",
    "courses:content": "tsx scripts/kajabi-course-content.ts",
    "config:diff": "dotenv -e .env.prod -- supabase config diff",
    "config:push": "dotenv -e .env.prod -- supabase config push",
    "slack:manifest:diff": "dotenv -e .env.prod -e .env.shared -- tsx scripts/slack-manifest.ts diff",
    "slack:manifest:push": "dotenv -e .env.prod -e .env.shared -- tsx scripts/slack-manifest.ts push",
    "github:config:diff": "tsx scripts/github-config.ts diff",
    "github:config:push": "tsx scripts/github-config.ts push",
    "vercel:config:diff": "dotenv -e .env.prod -e .env.shared -- tsx scripts/vercel-config.ts diff",
    "vercel:config:push": "dotenv -e .env.prod -e .env.shared -- tsx scripts/vercel-config.ts push",
    "quarantine:remove": "xattr -r -d com.apple.quarantine node_modules",
    "docs:toc": "doctoc --update-only --notitle --minlevel 2 --maxlevel 3",
    "prepare": "husky"
  },
  "dependencies": {
    "@mux/ts": "^15.6.1",
    "@next/third-parties": "16.4.2",
    "@sentry/nextjs": "^10.75.2",
    "@slack/web-api": "^7.15.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@tailwindcss/container-queries": "^0.1.1",
    "@tailwindcss/typography": "^0.5.20",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "@videojs/mux-video": "^10.1.0",
    "@videojs/react": "^10.1.0",
    "dotenv": "^17.4.2",
    "emojibase-data": "^18.0.0",
    "fflate": "^0.8.3",
    "googleapis": "^171.4.0",
    "html-to-image": "^1.11.13",
    "image-size": "^2.0.2",
    "json2csv": "^6.0.0-alpha.2",
    "lucide-react": "^1.61.0",
    "next": "16.4.2",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.3",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "remark-gfm": "^4.0.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "stripe": "^22.6.2",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@slack/types": "^2.22.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/json2csv": "^5.0.7",
    "@types/node": "^22.19.17",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^4.1.11",
    "@vitest/ui": "^4.1.11",
    "autoprefixer": "^10.6.1",
    "checkly": "latest",
    "doctoc": "^2.5.0",
    "dotenv-cli": "^11.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "msw": "^2.15.0",
    "playwright": "^1.64.1",
    "postcss": "^8.5.31",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vercel": "^60.1.3",
    "vite": "8.3.4",
    "vitest": "^4.1.11",
    "yaml": "^2.9.1"
  }
}
