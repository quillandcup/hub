# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your development credentials
#
# IMPORTANT:
# - .env.local is gitignored and used for local development only
# - Production/Preview environments use Vercel environment variables
# - Never commit secrets to git
# - See docs/DEPLOYMENT_SETUP.md for full setup guide
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase Configuration (DEVELOPMENT)
# ------------------------------------------------------------------------------
# Get these from your DEVELOPMENT Supabase project
# Dashboard → Settings → API
# Production uses different credentials set in Vercel dashboard

NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: Service role key for admin operations (keep secret!)
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Zoom API Credentials
# ------------------------------------------------------------------------------
# Create app at: https://marketplace.zoom.us/develop/create
# Use development/test credentials here

ZOOM_USER_EMAIL=your_zoom_email_address
ZOOM_ACCOUNT_ID=your_zoom_account_id
ZOOM_CLIENT_ID=your_zoom_client_id
ZOOM_CLIENT_SECRET=your_zoom_client_secret

# ------------------------------------------------------------------------------
# Google Calendar Integration
# ------------------------------------------------------------------------------
# Service account key from Google Cloud Console
# https://console.cloud.google.com/iam-admin/serviceaccounts
# Use development calendar for testing

GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}
GOOGLE_CALENDAR_ID=your_dev_calendar_id@group.calendar.google.com

# ------------------------------------------------------------------------------
# Google OAuth (per-user consent -- currently just event photo import, see
# app/(admin)/admin/events and app/api/oauth/google)
# ------------------------------------------------------------------------------
# The Photos API doesn't support service accounts for personal libraries, so
# this is a separate per-user OAuth 2.0 Web Client ID (not the Calendar
# service account above). Named after the provider, not "photos" -- one
# Google OAuth Client ID backs app/api/oauth/google/{start,callback}, shared
# by any future Google user-consent flow. Create it in the same Google Cloud
# project: https://console.cloud.google.com/apis/credentials
# 1. Enable the "Google Photos Picker API"
# 2. Create an OAuth client ID (Application type: Web application)
# 3. Add authorized redirect URIs -- one static path per origin (Google
#    requires an exact match, no wildcards/path templating, so this can't be
#    parameterized per-event -- the event id travels via the OAuth `state`
#    param instead, see lib/google-photos-picker/import-session-cookie.ts):
#      http://localhost:3000/api/oauth/google/callback
#      https://your-deployed-origin/api/oauth/google/callback
# 4. On the OAuth consent screen, add the staff who'll run imports as test
#    users (Testing mode) -- no Google verification needed for internal use

GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ------------------------------------------------------------------------------
# Kajabi Integration
# ------------------------------------------------------------------------------
# OAuth credentials for Kajabi API access
# Get from Kajabi: Settings → Integrations → API
# Site ID: Find in your Kajabi admin URL (e.g., /admin/sites/2147577478)

KAJABI_CLIENT_ID=your_kajabi_client_id
KAJABI_CLIENT_SECRET=your_kajabi_client_secret
KAJABI_SITE_ID=your_kajabi_site_id

# ------------------------------------------------------------------------------
# Slack Integration
# ------------------------------------------------------------------------------
# Create Slack app at: https://api.slack.com/apps
# Get bot token from OAuth & Permissions section
# Required scopes: channels:history, channels:read, users:read, reactions:read,
# chat:write, files:write (the last two are for feedback widget notifications
# — see slack-app-manifest.yml; re-install the app after adding new scopes)

SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Channel ID (not name) that new feedback-widget submissions post to.
# Find it via "Copy channel ID" in the channel's Slack details.
SLACK_FEEDBACK_CHANNEL_ID=C0your-channel-id

# Channel ID (not name) that staff notifications for newly-added books post to (see
# notifyStaffNewBook in lib/slack.ts), so staff can add the book to the Shopify store.
# Optional -- omit to silently disable this notification.
# SLACK_NEW_BOOKS_CHANNEL_ID=C0your-channel-id

# Writing Projects Phase 1 (pre/post-prickle nudge DMs, see lib/slack.ts) test-mode override.
# Safe by default: unset means "redirect everywhere except production" -- set SLACK_TEST_MODE
# explicitly to override that default in either direction. SLACK_DEV_USER_ID is where redirected
# DMs go (Slack profile -> "..." -> Copy member ID).
# SLACK_TEST_MODE=true
# SLACK_DEV_USER_ID=U0your-slack-member-id

# ------------------------------------------------------------------------------
# Stripe Integration
# ------------------------------------------------------------------------------
# Get API key from Stripe Dashboard: Developers → API keys
# Use test mode for development, live mode for production
# Format: sk_test_... (development) or sk_live_... (production)

STRIPE_API_KEY=sk_test_your_stripe_api_key

# ------------------------------------------------------------------------------
# Webhook Security (PRODUCTION ONLY - Set in Vercel)
# ------------------------------------------------------------------------------
# ⚠️  IMPORTANT: These are production secrets
# Set these ONLY in Vercel environment variables, NEVER in .env.local
# Vercel Dashboard → Settings → Environment Variables → Production
#
# Secret tokens for verifying webhook signatures
# These ensure webhooks are from the claimed source

# Zoom Webhook Secret Token (from Zoom webhook settings)
# ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret

# Slack Signing Secret (from Slack app settings)
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# Google Calendar uses channel tokens (set when creating watch)
# Generate with: openssl rand -hex 32
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=your_google_webhook_token

# ------------------------------------------------------------------------------
# Vercel Cron Jobs (Production only)
# ------------------------------------------------------------------------------
# Secret for authenticating cron job requests
# Generate with: openssl rand -hex 32
# Only needed in production; optional for testing locally

# CRON_SECRET=your_generated_secret_here

# ------------------------------------------------------------------------------
# Supabase pg_cron -> internal endpoint auth (Production only)
# ------------------------------------------------------------------------------
# Separate from CRON_SECRET above -- that one authenticates Vercel's own native cron jobs
# (vercel.json); this one authenticates Supabase pg_cron calling our own API routes via pg_net
# (see supabase/migrations/20260831170001_enable_pg_cron_pre_prickle_nudges.sql). A dedicated
# secret per trigger source keeps blast radius narrow if one ever leaks.
# Generate with: openssl rand -hex 32
# Must also be stored in Supabase Vault under the name pg_cron SQL references it by --
# use scripts/sync-vault-secrets.sh rather than the Supabase dashboard/SQL editor by hand.

# CRON_INTERNAL_SECRET=your_generated_secret_here

# ==============================================================================
# Quick Setup
# ==============================================================================
# Option 1: Pull from Vercel (recommended)
#   vercel env pull .env.local --environment=development
#
# Option 2: Use setup script
#   ./scripts/setup-environments.sh
#
# Option 3: Manual setup
#   Copy this file to .env.local and fill in values manually
# ==============================================================================
