# ==============================================================================
# Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local and fill in your development credentials.
#
# IMPORTANT:
# - .env.local is gitignored and used for local development only
# - Production/Preview environments use Vercel environment variables
# - Never commit secrets to git
# - See docs/DEPLOYMENT_SETUP.md for full setup guide
#
# Grouped and ordered to match env-vars.config.ts at the repo root -- that file is the
# source of truth for which vars exist, whether they're secret, and where they're synced.
# ==============================================================================

# ------------------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------------------
# Supabase project URL. Public by design.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
# Supabase anon key. Public by design -- RLS is what protects data, not this key's secrecy.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Bypasses RLS. Server-only.
# SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# Zoom
# ------------------------------------------------------------------------------
# Zoom account identifier.
ZOOM_ACCOUNT_ID=your_zoom_account_id
# Zoom OAuth app client ID.
ZOOM_CLIENT_ID=your_zoom_client_id
# Zoom OAuth app client secret.
ZOOM_CLIENT_SECRET=your_zoom_client_secret
# Verifies Zoom webhook signatures.
# ZOOM_WEBHOOK_SECRET_TOKEN=your_zoom_webhook_secret
# Zoom account email used for API calls.
ZOOM_USER_EMAIL=your_zoom_email_address

# ------------------------------------------------------------------------------
# Kajabi
# ------------------------------------------------------------------------------
# Kajabi OAuth app client ID.
KAJABI_CLIENT_ID=your_kajabi_client_id
# Kajabi OAuth app client secret.
KAJABI_CLIENT_SECRET=your_kajabi_client_secret
# Kajabi site identifier.
KAJABI_SITE_ID=your_kajabi_site_id

# ------------------------------------------------------------------------------
# Google Calendar
# ------------------------------------------------------------------------------
# Google Calendar ID synced for events.
GOOGLE_CALENDAR_ID=your_dev_calendar_id@group.calendar.google.com
# Full Google service account JSON key.
GOOGLE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"...","private_key":"..."}

# ------------------------------------------------------------------------------
# Google OAuth
# ------------------------------------------------------------------------------
# Google OAuth Web Client ID (per-user consent flows, e.g. Photos Picker).
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id.apps.googleusercontent.com
# Google OAuth Web Client secret.
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret

# ------------------------------------------------------------------------------
# Slack
# ------------------------------------------------------------------------------
# Slack bot OAuth token.
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
# Channel ID feedback-widget submissions post to.
SLACK_FEEDBACK_CHANNEL_ID=C0your-channel-id
# Channel ID for new-book staff notifications. Optional.
# SLACK_NEW_BOOKS_CHANNEL_ID=C0your-channel-id
# Channel ID for new-award staff notifications. Optional.
# SLACK_NEW_AWARDS_CHANNEL_ID=C0your-channel-id
# Slack member ID that redirected test-mode DMs go to.
# SLACK_DEV_USER_ID=U0your-slack-member-id
# Overrides default DM-redirect behavior outside production.
# SLACK_TEST_MODE=true

# ------------------------------------------------------------------------------
# Stripe
# ------------------------------------------------------------------------------
# Stripe secret API key.
STRIPE_API_KEY=sk_test_your_stripe_api_key

# ------------------------------------------------------------------------------
# Admin & Cron
# ------------------------------------------------------------------------------
# Signing secret for the admin sudo cookie.
SUDO_SECRET=your_generated_secret_here
# Authenticates Vercel's own native cron job requests.
# CRON_SECRET=your_generated_secret_here
# Authenticates Supabase pg_cron -> internal API route calls via pg_net.
# CRON_INTERNAL_SECRET=your_generated_secret_here

# ------------------------------------------------------------------------------
# Analytics & Monitoring
# ------------------------------------------------------------------------------
# GA4 measurement ID. Public by design.
NEXT_PUBLIC_GA_ID=G-your_measurement_id

# ------------------------------------------------------------------------------
# Ops (local scripts only)
# ------------------------------------------------------------------------------
# SMTP auth for Supabase Auth emails. Read by `npm run config:push` (supabase config push)
# via config.toml's env(RESEND_API_KEY); the app itself never reads it, so it isn't synced
# to Vercel.
RESEND_API_KEY=re_your_resend_api_key

# ------------------------------------------------------------------------------
# Not yet in env-vars.config.ts -- add them there instead of hand-editing this section.
# Both of these are production-only and set directly in the Vercel dashboard; neither
# has a local source of truth (not even in .env.prod), unlike everything else above.
# ------------------------------------------------------------------------------
# Slack Signing Secret (from Slack app settings)
# SLACK_SIGNING_SECRET=your_slack_signing_secret

# Google Calendar uses channel tokens (set when creating watch)
# Generate with: openssl rand -hex 32
# GOOGLE_CALENDAR_WEBHOOK_TOKEN=your_google_webhook_token

# ==============================================================================
# Quick Setup
# ==============================================================================
# Option 1: Pull from Vercel (recommended)
#   vercel env pull .env.local --environment=development
#
# Option 2: Use setup script
#   ./scripts/setup-environments.sh
#
# Option 3: Manual setup
#   Copy this file to .env.local and fill in values manually
# ==============================================================================
