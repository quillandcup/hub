# Pre-commit hook: refresh markdown tables of contents, then run the production build
# This catches TypeScript errors before committing

# Staged .md files that carry doctoc's START/END markers get their table of contents regenerated
# (pnpm docs:toc); files without the markers are left alone. To add one to a doc, put the two
# marker comments where the TOC should go (see docs/INTEGRATION_LINKS.md).
STAGED_DOCS=$(git diff --cached --name-only --diff-filter=ACM -- '*.md')
if [ -n "$STAGED_DOCS" ]; then
  echo "$STAGED_DOCS" | xargs pnpm --silent docs:toc > /dev/null
  echo "$STAGED_DOCS" | xargs git add
fi

# A new migration numbered at or below main's latest passes every test here, then makes
# `supabase db push` fail on main after merge. Refresh origin/main first (best effort,
# offline is fine) so the comparison is current.
git fetch origin main --quiet 2>/dev/null
pnpm --silent check:migrations || exit 1

# Nothing a build could catch changed when every staged file is documentation (the same check CI
# uses to skip its test and deploy jobs, decided from the files, not the commit message).
if [ "$(node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/docs-only.ts --staged 2>/dev/null)" = "true" ]; then
  echo "📝 Docs-only commit: skipping the production build."
  exit 0
fi

echo "🔍 Running production build before commit..."
pnpm build

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ Build failed! Fix TypeScript errors before committing."
  echo "   To skip this check, use: git commit --no-verify"
  exit 1
fi

echo "✅ Build successful! Proceeding with commit..."
exit 0
