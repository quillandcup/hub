{
  "worktree": {
    "setup": [
      "cp \"$PASEO_SOURCE_CHECKOUT_PATH/.env.local\" .env.local"
    ],
    "teardown": [
      "git checkout --detach",
      "git -C \"$PASEO_SOURCE_CHECKOUT_PATH\" branch -d \"$PASEO_BRANCH_NAME\" || true",
      "git -C \"$PASEO_SOURCE_CHECKOUT_PATH\" worktree prune"
    ]
  }
}
