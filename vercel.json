{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/reconcile/calendar",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/reconcile/zoom",
      "schedule": "30 2 * * *"
    },
    {
      "path": "/api/reconcile/slack",
      "schedule": "45 2 * * *"
    },
    {
      "path": "/api/reconcile/members",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/reconcile/logins",
      "schedule": "15 3 * * *"
    }
  ]
}
